{
  "name": "frontdesk-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "description": "Frontdesk — Customer Support Management System for Arvo Systems",
  "scripts": {
    "test": "cd backend && npm test",
    "test:sla": "cd backend && npm run test:sla",
    "test:incidents": "cd backend && npm run test:incidents",
    "backend:dev": "cd backend && npm run dev",
    "frontend:dev": "cd frontend && npm run dev",
    "build": "cd backend && npm run build && cd ../frontend && npm run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "@vercel/node": "^5.1.8",
    "typescript": "^5.7.2"
  }
}
